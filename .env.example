# Read by docker compose (variable substitution) and by Prisma CLI / the app on the host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=profile
DB_PORT=5445
APP_PORT=3100

# For the host only; inside compose the app gets DATABASE_URL built from POSTGRES_*.
# ${...} is expanded by dotenv-expand; keep POSTGRES_PASSWORD URL-safe.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}?schema=public"
